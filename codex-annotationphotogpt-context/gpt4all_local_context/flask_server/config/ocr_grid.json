{
  "name": "default_fr",
  "sampling": { "pages": 2, "strategy": "head+middle" },
  "variants": [
    {"dpi": 300, "psm": 6,  "oem": 3, "denoise": true,  "threshold": "adaptive", "deskew": true},
    {"dpi": 400, "psm": 6,  "oem": 3, "denoise": true,  "threshold": "adaptive", "deskew": true},
    {"dpi": 300, "psm": 11, "oem": 3, "denoise": true,  "threshold": "otsu",     "deskew": true},
    {"dpi": 300, "psm": 6,  "oem": 1, "denoise": false, "threshold": "adaptive", "deskew": true}
  ],
  "scoring": {
    "weights": {
      "median_conf": 0.50,
      "fr_word_ratio": 0.30,
      "bad_char_ratio": -0.10,
      "runtime_s": -0.10
    },
    "dictionary": "fra", 
    "use_wordfreq": true
  }
}
